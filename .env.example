# PostgreSQL connection for the local Docker Compose stack.
DATABASE_URL=postgresql+psycopg://sales_forecast:sales_forecast@postgres:5432/sales_forecast
LOG_LEVEL=INFO

# Required only for AI insights through an OpenAI-compatible provider such as ProxyAPI.
# Leave the key blank when the AI layer is not used.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.proxyapi.ru/v1
OPENAI_MODEL=gpt-5-mini
